{
  "name": "gauntlet",
  "version": "0.1.0",
  "description": "Adversarial checks for the code that turns model output into a tool call.",
  "license": "MIT",
  "author": "MrNirmata",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gauntlet": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrNirmata/gauntlet.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "postinstall": "mkdir -p node_modules/.bin && printf '%s\\n' '#!/bin/sh' 'exec node \"$(dirname \"$0\")/../../dist/cli.js\" \"$@\"' > node_modules/.bin/gauntlet && chmod +x node_modules/.bin/gauntlet"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
